{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregmos/memoforge/schemas/quotes.schema.json",
  "title": "memoforge research/quotes.json",
  "description": "Quote registry written by `mf quote extract` / `mf quote skip` (TZ v1.5 §5.3, M5).",
  "type": "object",
  "required": ["quotes", "skips"],
  "additionalProperties": false,
  "properties": {
    "quotes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/quote_id" },
      "additionalProperties": { "$ref": "#/$defs/quote" }
    },
    "skips": {
      "description": "Deliberate refusals to quote a source in a section; the writer may paraphrase with [[src:]] instead (TZ §4.4, L-08).",
      "type": "array",
      "items": { "$ref": "#/$defs/skip" }
    }
  },
  "$defs": {
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "section_id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "quote": {
      "type": "object",
      "required": ["source_id", "raw_sha256", "text", "char_start", "char_end", "lang", "words"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "raw_sha256": {
          "description": "sha of the raw file the range was extracted from; C-02 requires triple equality with the snapshot.",
          "$ref": "#/$defs/sha256"
        },
        "text": { "type": "string", "minLength": 1 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 },
        "lang": { "type": "string", "minLength": 2, "maxLength": 16 },
        "words": { "type": "integer", "minimum": 1 }
      }
    },
    "skip": {
      "type": "object",
      "required": ["section_id", "source_id", "reason", "at"],
      "additionalProperties": false,
      "properties": {
        "section_id": { "$ref": "#/$defs/section_id" },
        "source_id": { "$ref": "#/$defs/source_id" },
        "reason": {
          "enum": ["too_long", "ambiguous", "not_found", "no_raw", "raw_changed", "already_used", "other"]
        },
        "note": {
          "description": "Free-text reason; mandatory when reason = other, and then carried into drafting_warnings.",
          "type": "string",
          "minLength": 1
        },
        "at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "other" } },
            "required": ["reason"]
          },
          "then": { "required": ["note"] }
        }
      ]
    }
  }
}
