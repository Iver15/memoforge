{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregmos/memoforge/schemas/mcp-probe.schema.json",
  "title": "memoforge intake/mcp-probe.json",
  "description": "Legal MCP namespaces available in the session, probed by the orchestrator (TZ v1.5 §2.1 phase 1, §6).",
  "type": "object",
  "required": ["namespaces"],
  "additionalProperties": false,
  "properties": {
    "namespaces": {
      "type": "object",
      "required": ["other"],
      "additionalProperties": false,
      "properties": {
        "ldh": { "$ref": "#/$defs/namespace_or_null" },
        "courtlistener": { "$ref": "#/$defs/namespace_or_null" },
        "legalviz": { "$ref": "#/$defs/namespace_or_null" },
        "uklegal": { "$ref": "#/$defs/namespace_or_null" },
        "justicelibre": { "$ref": "#/$defs/namespace_or_null" },
        "opencaselaw": { "$ref": "#/$defs/namespace_or_null" },
        "fedregs": { "$ref": "#/$defs/namespace_or_null" },
        "lex": { "$ref": "#/$defs/namespace_or_null" },
        "other": {
          "type": "array",
          "items": { "$ref": "#/$defs/namespace" }
        }
      }
    },
    "status": {
      "type": "object",
      "description": "D-147: result of the one cheap smoke call per connected server; optional, so a probe written before D-147 stays valid and every connected server counts as ok.",
      "additionalProperties": false,
      "properties": {
        "ldh": { "$ref": "#/$defs/server_status" },
        "courtlistener": { "$ref": "#/$defs/server_status" },
        "legalviz": { "$ref": "#/$defs/server_status" },
        "uklegal": { "$ref": "#/$defs/server_status" },
        "justicelibre": { "$ref": "#/$defs/server_status" },
        "opencaselaw": { "$ref": "#/$defs/server_status" },
        "fedregs": { "$ref": "#/$defs/server_status" },
        "lex": { "$ref": "#/$defs/server_status" }
      }
    },
    "probed_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "namespace": { "type": "string", "minLength": 1 },
    "server_status": {
      "type": "string",
      "enum": ["ok", "quota", "auth", "error", "absent"]
    },
    "namespace_or_null": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/namespace" }]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
