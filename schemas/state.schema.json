{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/memoforge/schemas/state.schema.json",
  "title": "memoforge state.json v2",
  "description": "Normative shape of state.json (ТЗ §2.2). Written only by the CLI under state.lock (M2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "user_query",
    "created_at",
    "language",
    "work_dir",
    "output_folder",
    "mode",
    "config",
    "intake",
    "classification",
    "plan_approval",
    "current_phase",
    "dispatched_researchers",
    "current_iteration",
    "current_draft_path",
    "current_draft_sha",
    "draft_versions",
    "iterations",
    "client_readiness",
    "final_status",
    "final_status_reasons",
    "final_docx_path",
    "attempts",
    "sufficiency_followup",
    "drafting_warnings",
    "remaining_blocking_issues",
    "fallback_banners",
    "steps",
    "published",
    "progress",
    "sources_frozen",
    "cancel_requested"
  ],
  "properties": {
    "schema_version": {
      "description": "Always 2 for v2 tasks; `task resolve` answers `unsupported` for anything lower.",
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^memo-[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*$"
    },
    "user_query": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/iso_datetime"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "work_dir": {
      "type": "string",
      "minLength": 1
    },
    "output_folder": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "brief",
        "full",
        null
      ]
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "intake": {
      "type": [
        "object",
        "null"
      ]
    },
    "classification": {
      "type": [
        "object",
        "null"
      ]
    },
    "plan_approval": {
      "type": [
        "object",
        "null"
      ]
    },
    "current_phase": {
      "$ref": "#/$defs/phase"
    },
    "dispatched_researchers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_iteration": {
      "type": "integer",
      "minimum": 0
    },
    "current_draft_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_draft_sha": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/draft_version"
      }
    },
    "iterations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/iteration"
      }
    },
    "targeted_fix": {
      "description": "D-165: the one targeted citation pass of a run (§4.5 п.4 branch 9) — the iteration it produced and the reviewers dispatched for it. Absent or null when no such pass was issued; `mf task new` does not write it.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iteration",
            "reviewers"
          ],
          "properties": {
            "iteration": {
              "type": "integer",
              "minimum": 1
            },
            "reviewers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "client_readiness": {
      "type": [
        "object",
        "null"
      ]
    },
    "final_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_status_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_docx_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "$ref": "#/$defs/attempts"
    },
    "sufficiency_followup": {
      "$ref": "#/$defs/sufficiency_followup"
    },
    "mcp_exhausted": {
      "description": "Routing alias -> UTC date its provider quota ran out; that day the router drops its tools (D-122).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "drafting_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "remaining_blocking_issues": {
      "type": "array"
    },
    "fallback_banners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/banner"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "published": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/published_entry"
      }
    },
    "progress": {
      "oneOf": [
        {
          "$ref": "#/$defs/progress"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources_frozen": {
      "type": "boolean"
    },
    "cancel_requested": {
      "type": "boolean"
    }
  },
  "$defs": {
    "iso_datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "description": "Duplicated literally from scripts/memoforge/phases.py; test_phases.py asserts identity (M11).",
      "type": "string",
      "enum": [
        "intake_preliminary_research",
        "intake_questions_pending",
        "planning",
        "plan_approval_pending",
        "research",
        "research_sufficiency",
        "research_sufficiency_followup_pending",
        "research_insufficient_pending",
        "currency_check",
        "source_pack",
        "source_review_pending",
        "drafting",
        "revision_loop",
        "client_readiness",
        "export",
        "done",
        "failed",
        "cancelled_by_user"
      ]
    },
    "config": {
      "type": "object",
      "description": "Mode matrix (§2.3) merged with userConfig (§8.4) and the launcher discovery of §2.2. Closed: the two config keys removed in v2 are rejected (D-48; `test_state_io` names them).",
      "additionalProperties": false,
      "properties": {
        "python_cmd": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "plugin_data_dir": {
          "type": "string"
        },
        "source_review_gate": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "dashboard": {
          "type": "boolean"
        },
        "reviewer_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "researcher_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "lint_fix_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "intake_max_questions": {
          "type": "integer",
          "minimum": 1
        },
        "client_polish_enabled": {
          "type": "boolean"
        },
        "max_client_polish": {
          "type": "integer",
          "minimum": 0
        },
        "template_id": {
          "type": "string"
        },
        "writer_model": {
          "type": "string"
        },
        "publish_folder": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_profile_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_profile_mode_binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "prose_style_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation_style": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "footnotes",
            "inline",
            null
          ]
        },
        "mcp_budget": {
          "type": "object",
          "properties": {
            "ldh": {
              "type": "integer",
              "minimum": 0
            },
            "courtlistener": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "attempts": {
      "type": "object",
      "description": "Budget table of §2.2; scalar budgets count per task/phase, keyed ones per step/iteration.",
      "additionalProperties": false,
      "required": [
        "plan_edit",
        "research_dispatch_retry",
        "currency_regate",
        "client_polish",
        "lint_fix",
        "reviewer_json_retry",
        "reviewer_rerun",
        "single_dispatch_retry",
        "inline_llm_retry",
        "gate_parse_errors"
      ],
      "properties": {
        "plan_edit": {
          "type": "integer",
          "minimum": 0
        },
        "sufficiency_followup": {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy scalar of D-116, split into the two counters below; never written or read since — accepted so states from before the split still validate."
        },
        "sufficiency_user_followup": {
          "type": "integer",
          "minimum": 0
        },
        "sufficiency_research_followup": {
          "type": "integer",
          "minimum": 0
        },
        "research_dispatch_retry": {
          "type": "integer",
          "minimum": 0
        },
        "currency_regate": {
          "type": "integer",
          "minimum": 0
        },
        "client_polish": {
          "type": "integer",
          "minimum": 0
        },
        "lint_fix": {
          "$ref": "#/$defs/counter_map"
        },
        "reviewer_json_retry": {
          "$ref": "#/$defs/counter_map"
        },
        "reviewer_rerun": {
          "$ref": "#/$defs/counter_map"
        },
        "targeted_fix": {
          "type": "integer",
          "minimum": 0,
          "description": "D-165: targeted citation passes spent by branch 9 of §4.5 п.4; optional, so states written before D-165 stay valid."
        },
        "single_dispatch_retry": {
          "$ref": "#/$defs/counter_map"
        },
        "inline_llm_retry": {
          "$ref": "#/$defs/counter_map"
        },
        "gate_parse_errors": {
          "$ref": "#/$defs/counter_map"
        }
      }
    },
    "counter_map": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sufficiency_followup": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "subset_u": {
              "type": "array"
            },
            "subset_r": {
              "type": "array"
            },
            "approved_layers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Layers `mf sufficiency route` charged the research budget for; `[]` when that budget was already spent (D-116). Phase 5 dispatches exactly these, never a set re-derived from `subset_r`."
            },
            "questions": {
              "type": "array"
            },
            "user_response": {
              "type": [
                "string",
                "null"
              ]
            },
            "asked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "answered_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "warning": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "banner": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "banner_id",
            "text"
          ],
          "properties": {
            "banner_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "condition_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "iteration": {
      "type": "object",
      "description": "One `mf review aggregate` record (§4.5 п.3, D-77). `required` = every field `revision.py` branches on.",
      "additionalProperties": false,
      "required": [
        "iteration",
        "reviewers",
        "coverage",
        "failed_reviewers",
        "substance_blockers",
        "form_blockers",
        "conflict",
        "issues"
      ],
      "properties": {
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "draft_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downgraded_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "substance_blockers": {
          "type": "integer",
          "minimum": 0
        },
        "form_blockers": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic_blockers": {
          "type": "integer",
          "minimum": 0
        },
        "pass_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conflict": {
          "type": "boolean"
        },
        "stale_reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "description": "Merged reviewer issues; the shape is owned by the reviewer schemas (§6).",
          "items": {
            "type": "object"
          }
        },
        "aggregated_at": {
          "$ref": "#/$defs/iso_datetime"
        }
      }
    },
    "draft_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256",
        "lint_clean",
        "citations_clean",
        "checked_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lint_clean": {
          "type": "boolean"
        },
        "citations_clean": {
          "type": "boolean"
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "published_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_path",
        "sha256",
        "by",
        "at"
      ],
      "properties": {
        "canonical_path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "by": {
          "type": "string",
          "description": "step | command (§2.2)"
        },
        "step_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "step_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_path",
        "work_path"
      ],
      "properties": {
        "canonical_path": {
          "type": "string"
        },
        "work_path": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "step_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "agent_type",
        "attempt",
        "status"
      ],
      "properties": {
        "slot": {
          "type": "string"
        },
        "agent_type": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "ok",
            "fail",
            "no_change",
            "superseded"
          ]
        },
        "reported_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step_output"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "kind",
        "phase",
        "attempt",
        "reason",
        "status"
      ],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "dispatch",
            "script",
            "gate-text",
            "gate-auq",
            "inline-llm",
            "terminal"
          ]
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "issued_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "enum": [
            "initial",
            "failure",
            "recovery",
            "rerun"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step_agent"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inputs_sha": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step_output"
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "ok",
            "fail",
            "no_change",
            "skipped",
            "autoclosed"
          ]
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_ref": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "superseded": {
          "type": "boolean"
        }
      }
    },
    "progress": {
      "type": "object",
      "description": "Derived field: recomputed by `next`/`report` from steps[] and events.jsonl (§2.2).",
      "additionalProperties": false,
      "required": [
        "phase",
        "route",
        "position",
        "total",
        "active"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "phase_started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "agent_type"
            ],
            "properties": {
              "slot": {
                "type": "string"
              },
              "agent_type": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "started_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "last_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_memo": {
          "type": [
            "string",
            "null"
          ]
        },
        "mcp_calls": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
