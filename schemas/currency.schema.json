{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregmos/memoforge/schemas/currency.schema.json",
  "title": "memoforge research/currency.json",
  "description": "currency-checker output; source_id values come from the registry only (TZ v1.5 §2.1 phase 9, §4.1).",
  "type": "object",
  "required": ["checked_at", "sources", "blocking", "warnings"],
  "additionalProperties": false,
  "properties": {
    "checked_at": { "$ref": "#/$defs/date" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_currency" }
    },
    "blocking": {
      "description": "source_id of every source with status do_not_use; >=1 critical one re-gates to sufficiency.",
      "type": "array",
      "items": { "$ref": "#/$defs/source_id" }
    },
    "warnings": {
      "description": "source_id of every source with status outdated_but_usable, manual_check or unchecked.",
      "type": "array",
      "items": { "$ref": "#/$defs/source_id" }
    }
  },
  "$defs": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_currency": {
      "type": "object",
      "required": ["source_id", "status", "note"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "title": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["statutes", "case_law", "doctrine"] },
        "status": {
          "description": "`unchecked` is written by the CLI when the agent fails after its retry (TZ §2.1 phase 9).",
          "enum": ["current", "outdated_but_usable", "do_not_use", "manual_check", "unchecked"]
        },
        "note": { "type": "string" }
      }
    }
  }
}
