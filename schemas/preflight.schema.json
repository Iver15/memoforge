{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregmos/memoforge/schemas/preflight.schema.json",
  "title": "memoforge intake/preflight.json",
  "description": "One representative URL per routed portal host, probed before research starts (TZ v1.5 §2.1 phase 3, §4.3; D-147).",
  "type": "object",
  "required": ["schema_version", "checked_at", "hosts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "checked_at": { "$ref": "#/$defs/timestamp" },
    "offline": {
      "type": "boolean",
      "description": "true when MEMOFORGE_OFFLINE suppressed every request and the statuses are assumed."
    },
    "hosts": {
      "type": "array",
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "required": ["host", "url", "status"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "status": { "$ref": "#/$defs/status" },
        "code": {
          "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 100, "maximum": 599 }]
        },
        "error": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "alternative": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "status": {
      "type": "string",
      "enum": ["ok", "waf_challenge", "cloudflare", "interstitial", "dead", "tls"]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
