{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregmos/memoforge/schemas/review.schema.json",
  "title": "memoforge reviews/v<N>-<kind>.json",
  "description": "Reviewer output for one kind, or the CLI-written failure stub. Branches are selected by `reviewer` (and by `status` for the stub). `reasoning` MUST be emitted as the first key of the object (TZ v1.5 section 4.5 p.2). There is deliberately no maxItems on issues: the cap of five major issues is prompt guidance, not a schema constraint.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/logic_review" },
    { "$ref": "#/$defs/form_review" },
    { "$ref": "#/$defs/citations_review" },
    { "$ref": "#/$defs/counterarguments_review" },
    { "$ref": "#/$defs/stub" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "section_id": { "type": "string", "minLength": 1 },
    "checklist_id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["blocker", "major", "minor"] },
    "verdict": { "enum": ["approved", "needs_revision"] },
    "reviewer_kind": { "enum": ["logic", "form", "citations", "counterarguments"] },
    "checklist_item": {
      "description": "Binary grader item; the id set must equal the id set of lib/checklists/<kind>.json exactly (enforced by `mf review validate`).",
      "type": "object",
      "required": ["id", "pass", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/checklist_id" },
        "pass": { "enum": [true, false, "unknown"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "logic_issue": {
      "type": "object",
      "required": ["severity", "category", "section_id", "issue", "suggestion"],
      "additionalProperties": false,
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "type": "string", "minLength": 1 },
        "section_id": { "$ref": "#/$defs/section_id" },
        "issue": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 },
        "checklist_id": { "$ref": "#/$defs/checklist_id" }
      }
    },
    "form_issue": {
      "type": "object",
      "required": ["severity", "category", "section_id", "issue", "suggestion", "lens"],
      "additionalProperties": false,
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "type": "string", "minLength": 1 },
        "section_id": { "$ref": "#/$defs/section_id" },
        "issue": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 },
        "checklist_id": { "$ref": "#/$defs/checklist_id" },
        "lens": {
          "description": "form-reviewer merges the v1 clarity and style reviewers (TZ section 4.1).",
          "enum": ["clarity", "style"]
        }
      }
    },
    "citations_issue": {
      "type": "object",
      "required": ["severity", "category", "section_id", "issue", "suggestion", "issue_category"],
      "additionalProperties": false,
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "type": "string", "minLength": 1 },
        "section_id": { "$ref": "#/$defs/section_id" },
        "issue": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 },
        "checklist_id": { "$ref": "#/$defs/checklist_id" },
        "issue_category": {
          "description": "Only the three judgement calls left to the LLM. Existence, verbatim accuracy, currency and Sources-section coverage are decided by `mf draft audit-citations` (C-01..C-07) before the reviewer sees the draft, so the v1 categories ignored_blocking_currency, missing_in_sources_section, unverified_against_source and length_overflow_disclosure are gone (TZ section 4.1, section 5.4).",
          "enum": ["source_drift", "source_pack_mismatch", "unsupported_claim"]
        }
      }
    },
    "unverified_hard_fail_issue": {
      "description": "Written by `mf review validate` when a hard_fail checklist item is graded `unknown`: the verdict is lowered to needs_revision and this blocker records which item stayed unverified (TZ v1.5 section 4.5 p.2). It carries no reviewer-specific lens/issue_category/attack_vector because no reviewer authored it.",
      "type": "object",
      "required": ["severity", "category", "section_id", "issue", "suggestion", "checklist_id"],
      "additionalProperties": false,
      "properties": {
        "severity": { "const": "blocker" },
        "category": { "const": "unverified_hard_fail" },
        "section_id": { "$ref": "#/$defs/section_id" },
        "issue": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 },
        "checklist_id": { "$ref": "#/$defs/checklist_id" }
      }
    },
    "counterarguments_issue": {
      "type": "object",
      "required": ["severity", "category", "section_id", "issue", "suggestion", "attack_vector"],
      "additionalProperties": false,
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "type": "string", "minLength": 1 },
        "section_id": { "$ref": "#/$defs/section_id" },
        "issue": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 },
        "checklist_id": { "$ref": "#/$defs/checklist_id" },
        "attack_vector": {
          "enum": [
            "contrary_authority",
            "overconfidence",
            "missing_fact",
            "weak_application",
            "understated_risk"
          ]
        }
      }
    },
    "logic_review": {
      "type": "object",
      "required": ["reasoning", "reviewer", "draft_sha", "checklist", "issues", "verdict"],
      "additionalProperties": false,
      "properties": {
        "reasoning": { "type": "string", "minLength": 1 },
        "reviewer": { "const": "logic" },
        "draft_sha": { "$ref": "#/$defs/sha256" },
        "iteration": { "type": "integer", "minimum": 1 },
        "checklist": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checklist_item" } },
        "issues": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/logic_issue" },
              { "$ref": "#/$defs/unverified_hard_fail_issue" }
            ]
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    },
    "form_review": {
      "type": "object",
      "required": ["reasoning", "reviewer", "draft_sha", "checklist", "issues", "verdict"],
      "additionalProperties": false,
      "properties": {
        "reasoning": { "type": "string", "minLength": 1 },
        "reviewer": { "const": "form" },
        "draft_sha": { "$ref": "#/$defs/sha256" },
        "iteration": { "type": "integer", "minimum": 1 },
        "checklist": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checklist_item" } },
        "issues": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/form_issue" },
              { "$ref": "#/$defs/unverified_hard_fail_issue" }
            ]
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    },
    "citations_review": {
      "type": "object",
      "required": ["reasoning", "reviewer", "draft_sha", "checklist", "issues", "verdict"],
      "additionalProperties": false,
      "properties": {
        "reasoning": { "type": "string", "minLength": 1 },
        "reviewer": { "const": "citations" },
        "draft_sha": { "$ref": "#/$defs/sha256" },
        "iteration": { "type": "integer", "minimum": 1 },
        "checklist": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checklist_item" } },
        "issues": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/citations_issue" },
              { "$ref": "#/$defs/unverified_hard_fail_issue" }
            ]
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    },
    "counterarguments_review": {
      "type": "object",
      "required": ["reasoning", "reviewer", "draft_sha", "checklist", "issues", "verdict"],
      "additionalProperties": false,
      "properties": {
        "reasoning": { "type": "string", "minLength": 1 },
        "reviewer": { "const": "counterarguments" },
        "draft_sha": { "$ref": "#/$defs/sha256" },
        "iteration": { "type": "integer", "minimum": 1 },
        "checklist": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checklist_item" } },
        "issues": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/counterarguments_issue" },
              { "$ref": "#/$defs/unverified_hard_fail_issue" }
            ]
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    },
    "stub": {
      "description": "Written by the CLI when a reviewer fails after its reviewer_json_retry budget; carries no checklist, no verdict and no score (TZ section 4.5 p.3, fixes the v1 overall_score:0 defect).",
      "type": "object",
      "required": ["reviewer", "status", "reason"],
      "additionalProperties": false,
      "properties": {
        "reviewer": { "$ref": "#/$defs/reviewer_kind" },
        "status": { "const": "failed" },
        "reason": { "type": "string", "minLength": 1 },
        "draft_sha": { "$ref": "#/$defs/sha256" },
        "iteration": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
