{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregmos/memoforge/schemas/source-pack.schema.json",
  "title": "memoforge research/source-pack.json",
  "description": "Frozen snapshot published by `mf sources pack --freeze` in one transaction; after the freeze, lint, citation audit and rendering read only this file (TZ v1.5 §5.3, M6).",
  "type": "object",
  "required": ["schema_version", "frozen_at", "snapshot", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 2 },
    "frozen_at": { "$ref": "#/$defs/timestamp" },
    "snapshot": {
      "description": "The {source_id, raw_sha256} list pinned by the freeze; C-02 requires triple sha equality against it.",
      "type": "array",
      "items": { "$ref": "#/$defs/snapshot_entry" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "merged_into": {
      "description": "D34-04: `{dropped_source_id: canonical_source_id}` for the duplicate groups the freeze collapsed. Absent when nothing was merged; dropped ids have no entry and no snapshot row.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/source_id" },
      "additionalProperties": { "$ref": "#/$defs/source_id" }
    }
  },
  "$defs": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "issue_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "celex": { "type": "string", "minLength": 1 },
        "ecli": { "type": "string", "minLength": 1 },
        "eli": { "type": "string", "minLength": 1 },
        "reporter_cite": { "type": "string", "minLength": 1 },
        "neutral": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot_entry": {
      "type": "object",
      "required": ["source_id", "raw_sha256"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "raw_sha256": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        }
      }
    },
    "pack": {
      "type": "object",
      "required": ["role_by_issue", "weight", "confidence", "use_in_memo"],
      "additionalProperties": false,
      "properties": {
        "role_by_issue": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/issue_id" },
          "additionalProperties": {
            "enum": ["rule", "application", "risk", "background", "contrary"]
          }
        },
        "weight": { "enum": ["binding", "persuasive", "non_binding"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "use_in_memo": { "enum": ["rule", "application", "risk", "background", "do_not_use"] }
      }
    },
    "entry": {
      "description": "Citation-ready projection of a registry record; the docx renderer builds OSCOLA forms from these fields.",
      "type": "object",
      "required": ["source_id", "layer", "title", "citation_form", "url", "tier", "currency_status", "pack"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "layer": { "enum": ["statutes", "case_law", "doctrine"] },
        "title": { "type": "string", "minLength": 1 },
        "citation_form": { "type": "string", "minLength": 1 },
        "identifiers": { "$ref": "#/$defs/identifiers" },
        "url": {
          "description": "Copied verbatim from the registry; empty for a citation-only source.",
          "type": "string"
        },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "tier": { "enum": ["critical", "supporting", "background"] },
        "currency_status": {
          "enum": ["current", "outdated_but_usable", "do_not_use", "manual_check", "unchecked"]
        },
        "verification_us": { "enum": ["resolved", "unresolved", "ambiguous", "n/a"] },
        "pack": { "$ref": "#/$defs/pack" }
      }
    }
  }
}
