# Windows-first repository hygiene (ТЗ §5.6, M12).
* text=auto

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# cmd.exe needs CRLF batch files.
*.cmd text eol=crlf

# Extensionless POSIX launcher.
scripts/mf text eol=lf
