#!/usr/bin/env bash
# memoforge launcher (POSIX shells, incl. Git Bash): interpreter discovery -> __main__.py (ТЗ §5.6).
# Never depends on jsonschema; the same plugin_data_dir chain lives in scripts/memoforge/pylauncher.py.
set -u

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PLUGIN_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

VERSION_PROBE='import sys; sys.exit(0 if sys.version_info>=(3,9) else 1)'

# --- plugin_data_dir chain (ТЗ §2.5) --------------------------------------
# ${CLAUDE_PLUGIN_DATA} -> %LOCALAPPDATA%/claude/plugin-data/memoforge (Windows marker)
#                          / ~/.claude/plugin-data/memoforge -> <plugin_root>/.data
# A candidate is taken only when it can be created AND written to — the same criterion as
# pylauncher.plugin_data_dir(), otherwise the wrapper and the package would disagree.
mf_usable_dir() {
  [ -n "${1:-}" ] || return 1
  mkdir -p "$1" 2>/dev/null || return 1
  : >"$1/.mf-write-probe" 2>/dev/null || return 1
  rm -f "$1/.mf-write-probe" 2>/dev/null
  return 0
}

DATA_DIR=""
if [ -n "${CLAUDE_PLUGIN_DATA:-}" ] && mf_usable_dir "$CLAUDE_PLUGIN_DATA"; then
  DATA_DIR="$CLAUDE_PLUGIN_DATA"
fi
if [ -z "$DATA_DIR" ]; then
  if [ -n "${LOCALAPPDATA:-}" ]; then
    MF_HOME_CANDIDATE="$LOCALAPPDATA/claude/plugin-data/memoforge"
  elif [ -n "${HOME:-}" ]; then
    MF_HOME_CANDIDATE="$HOME/.claude/plugin-data/memoforge"
  else
    MF_HOME_CANDIDATE=""
  fi
  if mf_usable_dir "$MF_HOME_CANDIDATE"; then
    DATA_DIR="$MF_HOME_CANDIDATE"
  fi
fi
if [ -z "$DATA_DIR" ]; then
  DATA_DIR="$PLUGIN_ROOT/.data"
  mkdir -p "$DATA_DIR" 2>/dev/null || true
fi

# Service flag: print the resolved chain result and stop (identity test of §5.6).
if [ "${1:-}" = "--print-plugin-data-dir" ]; then
  printf '%s\n' "$DATA_DIR"
  exit 0
fi

MF_CACHE="$DATA_DIR/launcher.json"
MF_PYTHON=""
MF_PYTHON_ARGS=""
MF_FROM_CACHE=""

# --- discovery cache (<plugin_data_dir>/launcher.json) --------------------
# Read first: a hit costs one interpreter start instead of up to three (§5.6, G7).
if [ -f "$MF_CACHE" ]; then
  MF_CACHED="$(tr -d '\n' <"$MF_CACHE" 2>/dev/null |
    sed -n 's/.*"python_cmd"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' |
    tr -d '"' | tr ',' ' ')"
  if [ -n "${MF_CACHED:-}" ]; then
    MF_CACHED_EXE="${MF_CACHED%% *}"
    MF_CACHED_ARGS="${MF_CACHED#* }"
    [ "$MF_CACHED_ARGS" = "$MF_CACHED" ] && MF_CACHED_ARGS=""
    if [ -n "$MF_CACHED_EXE" ] && command -v "$MF_CACHED_EXE" >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      if "$MF_CACHED_EXE" $MF_CACHED_ARGS -c "$VERSION_PROBE" >/dev/null 2>&1; then
        MF_PYTHON="$MF_CACHED_EXE"
        MF_PYTHON_ARGS="$MF_CACHED_ARGS"
        MF_FROM_CACHE="1"
      fi
    fi
  fi
fi

# --- interpreter discovery: python -> python3 -> py -3 --------------------
# A Windows Store alias fails the version probe by its exit code and is skipped.
if [ -z "$MF_PYTHON" ]; then
  for MF_CANDIDATE in "python" "python3" "py -3"; do
    MF_EXE="${MF_CANDIDATE%% *}"
    command -v "$MF_EXE" >/dev/null 2>&1 || continue
    # shellcheck disable=SC2086
    if $MF_CANDIDATE -c "$VERSION_PROBE" >/dev/null 2>&1; then
      MF_PYTHON="$MF_EXE"
      case "$MF_CANDIDATE" in
        *" "*) MF_PYTHON_ARGS="${MF_CANDIDATE#* }" ;;
      esac
      break
    fi
  done
fi

if [ -z "$MF_PYTHON" ]; then
  echo "mf: no Python >= 3.9 found (tried python, python3, py -3)" >&2
  exit 2
fi

# Miss (or a stale cache) rewrites the cache with what discovery just found.
if [ -z "$MF_FROM_CACHE" ]; then
  if [ -n "$MF_PYTHON_ARGS" ]; then
    MF_PY_JSON="\"$MF_PYTHON\", \"$MF_PYTHON_ARGS\""
  else
    MF_PY_JSON="\"$MF_PYTHON\""
  fi
  MF_TMP="$MF_CACHE.$$"
  if printf '{"schema_version": 1, "kind": "launcher", "python_cmd": [%s], "source": "mf"}\n' \
      "$MF_PY_JSON" >"$MF_TMP" 2>/dev/null; then
    mv -f "$MF_TMP" "$MF_CACHE" 2>/dev/null || rm -f "$MF_TMP" 2>/dev/null || true
  fi
fi

# --- PYTHONPATH += <plugin_data_dir>/site-packages ------------------------
if [ -n "${LOCALAPPDATA:-}" ]; then
  MF_PATHSEP=";"
else
  MF_PATHSEP=":"
fi
if [ -n "${PYTHONPATH:-}" ]; then
  PYTHONPATH="$DATA_DIR/site-packages$MF_PATHSEP$PYTHONPATH"
else
  PYTHONPATH="$DATA_DIR/site-packages"
fi
export PYTHONPATH

# shellcheck disable=SC2086
exec "$MF_PYTHON" $MF_PYTHON_ARGS "$PLUGIN_ROOT/scripts/memoforge/__main__.py" "$@"
